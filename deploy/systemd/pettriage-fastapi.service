[Unit]
Description=PetTriage FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/SKN32-4th-5Team
ExecStart=/home/ubuntu/SKN32-4th-5Team/.venv/bin/uvicorn pettriage.app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
